{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cassindex.ru/data/public/schema/v1/index.schema.json",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "site",
    "license",
    "weeks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cassandra-index-public"
    },
    "schema_version": {
      "const": 1
    },
    "site": {
      "const": "https://cassindex.ru"
    },
    "license": {
      "type": "object",
      "required": [
        "name",
        "url",
        "attribution",
        "note",
        "placeholder"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "CC BY 4.0"
        },
        "url": {
          "const": "https://creativecommons.org/licenses/by/4.0/legalcode"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "const": false
        }
      }
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "week.schema.json#/$defs/week"
      }
    }
  }
}
