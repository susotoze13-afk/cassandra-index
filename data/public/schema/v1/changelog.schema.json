{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cassindex.ru/data/public/schema/v1/changelog.schema.json",
  "title": "Cassandra Index — история изменений публичного слоя",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cassandra-index-changelog"
    },
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "date",
        "version",
        "kind",
        "title",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "methodology",
            "taxonomy",
            "schema",
            "field",
            "fix",
            "product"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "link": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        }
      }
    }
  }
}
