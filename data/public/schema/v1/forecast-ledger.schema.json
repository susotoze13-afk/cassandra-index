{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cassindex.ru/data/public/schema/v1/forecast-ledger.schema.json",
  "title": "Cassandra Index — реестр прогнозов и их проверки",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "site",
    "license",
    "rule",
    "entries",
    "summary",
    "misses"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cassandra-index-forecast-ledger"
    },
    "schema_version": {
      "const": 1
    },
    "site": {
      "const": "https://cassindex.ru"
    },
    "license": {
      "type": "object",
      "required": [
        "name",
        "url",
        "attribution",
        "note",
        "placeholder"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "CC BY 4.0"
        },
        "url": {
          "const": "https://creativecommons.org/licenses/by/4.0/legalcode"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "const": false
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "cluster",
        "direction",
        "baseline"
      ],
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "object",
          "required": [
            "deadband",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "deadband": {
              "type": "number",
              "minimum": 0
            },
            "values": {
              "type": "array",
              "items": {
                "enum": [
                  "down",
                  "flat",
                  "up"
                ]
              }
            }
          }
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "baseline",
        "editor"
      ],
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/bucket"
        },
        "editor": {
          "$ref": "#/$defs/bucket"
        }
      }
    },
    "misses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "week",
          "kind",
          "field",
          "expected",
          "actual"
        ],
        "additionalProperties": false,
        "properties": {
          "week": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "baseline",
              "editor"
            ]
          },
          "field": {
            "enum": [
              "cluster",
              "direction"
            ]
          },
          "expected": {
            "type": [
              "string",
              "null"
            ]
          },
          "actual": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "week",
        "kind",
        "committedAt",
        "verified",
        "expectedCluster",
        "expectedDirection",
        "actualIndex",
        "actualCluster",
        "actualDelta",
        "actualDirection",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "week": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "kind": {
          "enum": [
            "baseline",
            "editor"
          ]
        },
        "committedAt": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "expectedCluster": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedDirection": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "down",
            "flat",
            "up",
            null
          ]
        },
        "actualIndex": {
          "type": [
            "integer",
            "null"
          ]
        },
        "actualCluster": {
          "type": [
            "string",
            "null"
          ]
        },
        "actualDelta": {
          "type": [
            "integer",
            "null"
          ]
        },
        "actualDirection": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "down",
            "flat",
            "up",
            null
          ]
        },
        "outcome": {
          "type": "object",
          "required": [
            "cluster",
            "direction"
          ],
          "additionalProperties": false,
          "properties": {
            "cluster": {
              "enum": [
                "hit",
                "miss",
                "pending"
              ]
            },
            "direction": {
              "enum": [
                "hit",
                "miss",
                "pending"
              ]
            }
          }
        }
      }
    },
    "tally": {
      "type": "object",
      "required": [
        "hits",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "hits": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bucket": {
      "type": "object",
      "required": [
        "entries",
        "cluster",
        "direction",
        "pending"
      ],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "cluster": {
          "$ref": "#/$defs/tally"
        },
        "direction": {
          "$ref": "#/$defs/tally"
        },
        "pending": {
          "type": "object",
          "required": [
            "cluster",
            "direction"
          ],
          "additionalProperties": false,
          "properties": {
            "cluster": {
              "type": "integer",
              "minimum": 0
            },
            "direction": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
