{
  "version": "2.6",
  "variables": {
    "bg": { "type": "color", "value": "#0A0E12" },
    "surface": { "type": "color", "value": "#121820" },
    "surface-2": { "type": "color", "value": "#1A2028" },
    "border": { "type": "color", "value": "#232B36" },
    "border-soft": { "type": "color", "value": "#1A2028" },
    "text": { "type": "color", "value": "#E6EDF3" },
    "text-secondary": { "type": "color", "value": "#8B949E" },
    "text-muted": { "type": "color", "value": "#6B7280" },
    "text-on-accent": { "type": "color", "value": "#0A0E12" },
    "accent": { "type": "color", "value": "#58A6FF" },
    "accent-soft": { "type": "color", "value": "#58A6FF24" },
    "accent-line": { "type": "color", "value": "#58A6FF73" },
    "state-calm": { "type": "color", "value": "#3FB950" },
    "state-tense": { "type": "color", "value": "#A8B06B" },
    "state-danger": { "type": "color", "value": "#D29922" },
    "state-very": { "type": "color", "value": "#D17F52" },
    "state-critical": { "type": "color", "value": "#F85149" },
    "state-extreme": { "type": "color", "value": "#A83A3A" },
    "overlay-header": { "type": "color", "value": "#0A0E12D9" }
  },
  "children": [
    {
      "type": "frame",
      "id": "scr-hero-desktop",
      "name": "Desktop — Hero",
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 900,
      "clip": true,
      "fill": "$bg",
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "hero-header",
          "name": "Header",
          "width": "fill_container",
          "height": 64,
          "padding": [0, 64],
          "justifyContent": "space_between",
          "alignItems": "center",
          "fill": "$overlay-header",
          "children": [
            {
              "type": "text",
              "id": "hero-brand",
              "name": "Brand",
              "content": "Cassandra Index",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "600",
              "fill": "$text"
            },
            {
              "type": "frame",
              "id": "hero-nav",
              "name": "Nav",
              "gap": 32,
              "alignItems": "center",
              "children": [
                { "type": "text", "id": "nav-overview", "content": "Обзор", "fontFamily": "Inter", "fontSize": 14, "fill": "$text-secondary" },
                { "type": "text", "id": "nav-regions", "content": "Регионы", "fontFamily": "Inter", "fontSize": 14, "fill": "$text-secondary" },
                { "type": "text", "id": "nav-trend", "content": "Тренд", "fontFamily": "Inter", "fontSize": 14, "fill": "$text-secondary" },
                { "type": "text", "id": "nav-method", "content": "Методология", "fontFamily": "Inter", "fontSize": 14, "fill": "$text-secondary" }
              ]
            },
            {
              "type": "frame",
              "id": "hero-lang",
              "name": "Lang switch",
              "gap": 8,
              "alignItems": "center",
              "children": [
                { "type": "text", "id": "lang-ru", "content": "RU", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "600", "fill": "$accent" },
                { "type": "text", "id": "lang-en", "content": "EN", "fontFamily": "Inter", "fontSize": 13, "fill": "$text-muted" }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "hero-body",
          "name": "Hero body",
          "width": "fill_container",
          "height": "fill_container",
          "padding": [56, 64],
          "gap": 32,
          "layout": "vertical",
          "children": [
            {
              "type": "text",
              "id": "hero-title",
              "name": "Title",
              "content": "Насколько близко мир подошёл к глобальному военному конфликту?",
              "fontFamily": "Inter",
              "fontSize": 40,
              "fontWeight": "600",
              "lineHeight": 1.15,
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "fill": "$text"
            },
            {
              "type": "text",
              "id": "hero-subtitle",
              "name": "Subtitle",
              "content": "Это индекс состояния риска от 0 до 100, а не вероятность начала войны и не обратный отсчёт.",
              "fontFamily": "Inter",
              "fontSize": 16,
              "lineHeight": 1.5,
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "fill": "$text-secondary"
            },
            {
              "type": "frame",
              "id": "hero-index-row",
              "name": "Global index",
              "gap": 24,
              "alignItems": "end",
              "children": [
                {
                  "type": "text",
                  "id": "hero-index-value",
                  "name": "Index value",
                  "content": "72",
                  "fontFamily": "Inter",
                  "fontSize": 168,
                  "fontWeight": "600",
                  "lineHeight": 1,
                  "fill": "$text"
                },
                {
                  "type": "frame",
                  "id": "hero-index-meta",
                  "name": "Index meta",
                  "gap": 10,
                  "layout": "vertical",
                  "children": [
                    { "type": "text", "id": "hero-index-of", "content": "из 100", "fontFamily": "Inter", "fontSize": 18, "fill": "$text-muted" },
                    { "type": "text", "id": "hero-status", "content": "Очень опасно", "fontFamily": "Inter", "fontSize": 18, "fontWeight": "600", "fill": "$state-very" }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "id": "hero-delta",
              "name": "Weekly change",
              "content": "↑ +6 за неделю",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600",
              "fill": "$state-very"
            },
            {
              "type": "frame",
              "id": "hero-dates",
              "name": "Dates",
              "width": "fill_container",
              "justifyContent": "space_between",
              "children": [
                { "type": "text", "id": "date-published", "content": "Последняя публикация: 13 сентября 2026", "fontFamily": "Inter", "fontSize": 14, "fill": "$text-muted" },
                { "type": "text", "id": "date-through", "content": "Данные по: 6 сентября 2026", "fontFamily": "Inter", "fontSize": 14, "fill": "$text-muted" }
              ]
            },
            {
              "type": "frame",
              "id": "hero-region-card",
              "name": "Region card",
              "width": 560,
              "clip": true,
              "cornerRadius": 12,
              "fill": "$surface",
              "children": [
                {
                  "type": "frame",
                  "id": "region-card-strip",
                  "name": "Status strip",
                  "width": 4,
                  "height": "fill_container",
                  "fill": "$state-very"
                },
                {
                  "type": "frame",
                  "id": "region-card-body",
                  "name": "Card body",
                  "width": "fill_container",
                  "padding": 24,
                  "gap": 12,
                  "layout": "vertical",
                  "children": [
                    {
                      "type": "frame",
                      "id": "region-card-title",
                      "name": "Card title",
                      "gap": 16,
                      "alignItems": "center",
                      "children": [
                        { "type": "text", "id": "region-yours", "content": "ВАШ РЕГИОН", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "600", "letterSpacing": 1, "fill": "$text-muted" },
                        { "type": "text", "id": "region-city", "content": "Амстердам", "fontFamily": "Inter", "fontSize": 20, "fontWeight": "600", "fill": "$text" }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "region-card-sub",
                      "name": "Region and change link",
                      "gap": 10,
                      "alignItems": "center",
                      "children": [
                        { "type": "text", "id": "region-name", "content": "Европа · 74", "fontFamily": "Inter", "fontSize": 15, "fill": "$text-secondary" },
                        { "type": "text", "id": "region-change", "content": "изменить", "fontFamily": "Inter", "fontSize": 14, "underline": true, "fill": "$accent" }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "region-card-stats",
                      "name": "Region stats",
                      "gap": 20,
                      "alignItems": "center",
                      "children": [
                        { "type": "text", "id": "region-index", "content": "74", "fontFamily": "Inter", "fontSize": 32, "fontWeight": "600", "fill": "$text" },
                        { "type": "text", "id": "region-status", "content": "очень опасно", "fontFamily": "Inter", "fontSize": 15, "fill": "$state-very" },
                        { "type": "text", "id": "region-delta", "content": "↑ +5 за неделю", "fontFamily": "Inter", "fontSize": 15, "fontWeight": "600", "fill": "$state-very" }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "region-note",
                      "name": "Region note",
                      "content": "Это контекстный региональный риск, а не прогноз атаки на этот город.",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "lineHeight": 1.5,
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "fill": "$text-muted"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "scr-sections-desktop",
      "name": "Desktop — Sections",
      "x": 1560,
      "y": 0,
      "width": 1440,
      "clip": true,
      "fill": "$bg",
      "layout": "vertical",
      "padding": [64, 64],
      "gap": 72,
      "children": [
        {
          "type": "frame",
          "id": "sec-drivers",
          "name": "Section: Что изменилось",
          "width": "fill_container",
          "gap": 24,
          "layout": "vertical",
          "children": [
            {
              "type": "text",
              "id": "drivers-title",
              "name": "Section title",
              "content": "Что изменилось",
              "fontFamily": "Inter",
              "fontSize": 28,
              "fontWeight": "600",
              "fill": "$text"
            },
            {
              "type": "frame",
              "id": "drivers-cards",
              "name": "Driver cards",
              "width": "fill_container",
              "gap": 24,
              "alignItems": "start",
              "children": [
                {
                  "type": "frame",
                  "id": "driver-card-1",
                  "name": "Driver card 1",
                  "width": "fill_container",
                  "padding": 24,
                  "gap": 12,
                  "layout": "vertical",
                  "cornerRadius": 12,
                  "fill": "$surface",
                  "children": [
                    { "type": "text", "id": "d1-label", "content": "Военная активность выросла", "fontFamily": "Inter", "fontSize": 16, "fontWeight": "600", "textGrowth": "fixed-width", "width": "fill_container", "fill": "$text" },
                    { "type": "text", "id": "d1-obs", "content": "Спутниковые снимки фиксируют переброску дополнительных сил в приграничных округах двух государств.", "fontFamily": "Inter", "fontSize": 14, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": "fill_container", "fill": "$text-secondary" },
                    { "type": "text", "id": "d1-contribution", "content": "Вклад — высокий", "fontFamily": "Inter", "fontSize": 13, "fill": "$text-secondary" },
                    { "type": "text", "id": "d1-confidence", "content": "Уверенность — высокая", "fontFamily": "Inter", "fontSize": 13, "fill": "$text-secondary" },
                    {
                      "type": "frame",
                      "id": "d1-sources-btn",
                      "name": "Sources button",
                      "padding": [10, 16],
                      "gap": 8,
                      "alignItems": "center",
                      "cornerRadius": 8,
                      "fill": "$accent-soft",
                      "stroke": "$accent-line",
                      "strokeWidth": 1,
                      "children": [
                        { "type": "text", "id": "d1-sources-label", "content": "3 источника", "fontFamily": "Inter", "fontSize": 14, "fontWeight": "600", "fill": "$accent" },
                        { "type": "icon", "id": "d1-chevron", "library": "lucide", "icon": "chevron-down", "width": 16, "height": 16, "fill": "$accent" }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "driver-card-2",
                  "name": "Driver card 2",
                  "width": "fill_container",
                  "padding": 24,
                  "gap": 12,
                  "layout": "vertical",
                  "cornerRadius": 12,
                  "fill": "$surface",
                  "children": [
                    { "type": "text", "id": "d2-label", "content": "Интенсивность столкновений выросла", "fontFamily": "Inter", "fontSize": 16, "fontWeight": "600", "textGrowth": "fixed-width", "width": "fill_container", "fill": "$text" },
                    { "type": "text", "id": "d2-obs", "content": "Число боестолкновений вдоль линии соприкосновения за неделю выросло по данным независимого мониторинга.", "fontFamily": "Inter", "fontSize": 14, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": "fill_container", "fill": "$text-secondary" },
                    { "type": "text", "id": "d2-contribution", "content": "Вклад — высокий", "fontFamily": "Inter", "fontSize": 13, "fill": "$text-secondary" },
                    { "type": "text", "id": "d2-confidence", "content": "Уверенность — средняя", "fontFamily": "Inter", "fontSize": 13, "fill": "$text-secondary" },
                    { "type": "text", "id": "d2-confidence-note", "content": "Независимые источники дают противоречивые показания по интенсивности.", "fontFamily": "Inter", "fontSize": 13, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": "fill_container", "fill": "$text-muted" },
                    {
                      "type": "frame",
                      "id": "d2-sources-btn",
                      "name": "Sources button",
                      "padding": [10, 16],
                      "gap": 8,
                      "alignItems": "center",
                      "cornerRadius": 8,
                      "fill": "$accent-soft",
                      "stroke": "$accent-line",
                      "strokeWidth": 1,
                      "children": [
                        { "type": "text", "id": "d2-sources-label", "content": "2 источника", "fontFamily": "Inter", "fontSize": 14, "fontWeight": "600", "fill": "$accent" },
                        { "type": "icon", "id": "d2-chevron", "library": "lucide", "icon": "chevron-down", "width": 16, "height": 16, "fill": "$accent" }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "driver-card-3",
                  "name": "Driver card 3",
                  "width": "fill_container",
                  "padding": 24,
                  "gap": 12,
                  "layout": "vertical",
                  "cornerRadius": 12,
                  "fill": "$surface",
                  "children": [
                    { "type": "text", "id": "d3-label", "content": "Оборонные расходы растут", "fontFamily": "Inter", "fontSize": 16, "fontWeight": "600", "textGrowth": "fixed-width", "width": "fill_container", "fill": "$text" },
                    { "type": "text", "id": "d3-obs", "content": "Несколько государств объявили об увеличении оборонных бюджетов на следующий финансовый год.", "fontFamily": "Inter", "fontSize": 14, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": "fill_container", "fill": "$text-secondary" },
                    { "type": "text", "id": "d3-contribution", "content": "Вклад — средний", "fontFamily": "Inter", "fontSize": 13, "fill": "$text-secondary" },
                    { "type": "text", "id": "d3-confidence", "content": "Уверенность — высокая", "fontFamily": "Inter", "fontSize": 13, "fill": "$text-secondary" },
                    {
                      "type": "frame",
                      "id": "d3-sources-btn",
                      "name": "Sources button",
                      "padding": [10, 16],
                      "gap": 8,
                      "alignItems": "center",
                      "cornerRadius": 8,
                      "fill": "$accent-soft",
                      "stroke": "$accent-line",
                      "strokeWidth": 1,
                      "children": [
                        { "type": "text", "id": "d3-sources-label", "content": "2 источника", "fontFamily": "Inter", "fontSize": 14, "fontWeight": "600", "fill": "$accent" },
                        { "type": "icon", "id": "d3-chevron", "library": "lucide", "icon": "chevron-down", "width": 16, "height": 16, "fill": "$accent" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "sec-measures",
          "name": "Section: Дополнительные измерения",
          "width": "fill_container",
          "gap": 16,
          "layout": "vertical",
          "children": [
            {
              "type": "text",
              "id": "measures-title",
              "name": "Section title",
              "content": "Дополнительные измерения риска",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600",
              "fill": "$text"
            },
            {
              "type": "frame",
              "id": "measure-direct-row",
              "name": "Measure: direct",
              "gap": 12,
              "alignItems": "center",
              "children": [
                { "type": "text", "id": "measure-direct-name", "content": "Прямое военное столкновение", "fontFamily": "Inter", "fontSize": 15, "fill": "$text" },
                { "type": "text", "id": "measure-direct-dash", "content": "—", "fontFamily": "Inter", "fontSize": 15, "fill": "$text-muted" },
                { "type": "text", "id": "measure-direct-level", "content": "Высокий", "fontFamily": "Inter", "fontSize": 15, "fontWeight": "600", "fill": "$state-danger" }
              ]
            },
            {
              "type": "frame",
              "id": "measure-nuclear-row",
              "name": "Measure: nuclear",
              "gap": 12,
              "alignItems": "center",
              "children": [
                { "type": "text", "id": "measure-nuclear-name", "content": "Риск применения ядерного оружия", "fontFamily": "Inter", "fontSize": 15, "fill": "$text" },
                { "type": "text", "id": "measure-nuclear-dash", "content": "—", "fontFamily": "Inter", "fontSize": 15, "fill": "$text-muted" },
                { "type": "text", "id": "measure-nuclear-level", "content": "Низкий", "fontFamily": "Inter", "fontSize": 15, "fontWeight": "600", "fill": "$state-calm" }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "sec-trend",
          "name": "Section: Тренд за 12 недель",
          "width": "fill_container",
          "gap": 20,
          "layout": "vertical",
          "children": [
            {
              "type": "text",
              "id": "trend-title",
              "name": "Section title",
              "content": "Тренд за 12 недель",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600",
              "fill": "$text"
            },
            {
              "type": "frame",
              "id": "trend-chart",
              "name": "Trend chart",
              "width": "fill_container",
              "gap": 16,
              "alignItems": "end",
              "children": [
                {
                  "type": "frame",
                  "id": "trend-y-axis",
                  "name": "Y axis",
                  "height": 200,
                  "justifyContent": "space_between",
                  "alignItems": "end",
                  "layout": "vertical",
                  "children": [
                    { "type": "text", "id": "y-90", "content": "90", "fontFamily": "Inter", "fontSize": 12, "fill": "$text-muted" },
                    { "type": "text", "id": "y-60", "content": "60", "fontFamily": "Inter", "fontSize": 12, "fill": "$text-muted" },
                    { "type": "text", "id": "y-30", "content": "30", "fontFamily": "Inter", "fontSize": 12, "fill": "$text-muted" }
                  ]
                },
                {
                  "type": "frame",
                  "id": "trend-bars",
                  "name": "Bars",
                  "width": "fill_container",
                  "height": 200,
                  "gap": 10,
                  "alignItems": "end",
                  "children": [
                    { "type": "rectangle", "id": "bar-1", "width": "fill_container", "height": 112, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-2", "width": "fill_container", "height": 116, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-3", "width": "fill_container", "height": 118, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-4", "width": "fill_container", "height": 118, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-5", "width": "fill_container", "height": 124, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-6", "width": "fill_container", "height": 128, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-7", "width": "fill_container", "height": 130, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-8", "width": "fill_container", "height": 132, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-9", "width": "fill_container", "height": 134, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-10", "width": "fill_container", "height": 138, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-11", "width": "fill_container", "height": 142, "fill": "$accent" },
                    { "type": "rectangle", "id": "bar-12", "width": "fill_container", "height": 144, "fill": "$accent" }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "trend-tooltip",
              "name": "Tooltip",
              "padding": [8, 12],
              "alignItems": "center",
              "cornerRadius": 8,
              "fill": "$surface-2",
              "stroke": "$border",
              "strokeWidth": 1,
              "children": [
                { "type": "text", "id": "tooltip-text", "content": "13.09 — 72 · неделю назад — 71", "fontFamily": "Inter", "fontSize": 13, "fill": "$text" }
              ]
            },
            {
              "type": "frame",
              "id": "trend-caption",
              "name": "Trend caption",
              "gap": 16,
              "alignItems": "center",
              "children": [
                { "type": "text", "id": "trend-current", "content": "Сейчас — 72", "fontFamily": "Inter", "fontSize": 14, "fontWeight": "600", "fill": "$text" },
                { "type": "text", "id": "trend-week-ago", "content": "неделю назад — 71", "fontFamily": "Inter", "fontSize": 14, "fill": "$text-secondary" },
                { "type": "text", "id": "trend-range", "content": "12 недель: 56 → 72", "fontFamily": "Inter", "fontSize": 14, "fill": "$text-muted" }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "scr-regions-desktop",
      "name": "Desktop — Regions",
      "x": 0,
      "y": 1100,
      "width": 1440,
      "clip": true,
      "fill": "$bg",
      "layout": "vertical",
      "padding": [64, 64],
      "gap": 40,
      "children": [
        {
          "type": "text",
          "id": "regions-title",
          "name": "Section title",
          "content": "Где риск изменился сильнее всего",
          "fontFamily": "Inter",
          "fontSize": 28,
          "fontWeight": "600",
          "fill": "$text"
        },
        {
          "type": "frame",
          "id": "regions-list",
          "name": "Region list",
          "width": "fill_container",
          "layout": "vertical",
          "children": [
            {
